<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt.Views.MainPage"
             BackgroundColor="#F2F4F8">

    <Grid Padding="24" RowDefinitions="Auto,*" RowSpacing="14">

        <VerticalStackLayout Grid.Row="0" Spacing="14">

            <Label Text="{Binding TitleText}"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#202535" />

            <Entry x:Name="NameEntry"
                   Placeholder="{Binding NameHint}"
                   TextColor="#202535"
                   PlaceholderColor="#687086"
                   BackgroundColor="White" />

            <Entry x:Name="StartValueEntry"
                   Placeholder="{Binding StartValueHint}"
                   Keyboard="Numeric"
                   TextColor="#202535"
                   PlaceholderColor="#687086"
                   BackgroundColor="White" />

            <Button Text="{Binding AddButtonText}"
                    BackgroundColor="#4B79E8"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="OnAddCounterClicked" />

            <Button Text="{Binding SaveButtonText}"
                    BackgroundColor="#4A9B70"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="OnSaveClicked" />

            <Label x:Name="StatusLabel"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#687086" />
        </VerticalStackLayout>

        <CollectionView x:Name="CountersView" Grid.Row="1">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            Padding="18"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="#202535" />

                            <Label Text="{Binding Value}"
                                   FontSize="48"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="#202535" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0"
                                        Text="−"
                                        FontSize="28"
                                        BackgroundColor="#E75B5B"
                                        TextColor="White"
                                        CornerRadius="12"
                                        Clicked="OnMinusClicked" />
                                <Button Grid.Column="1"
                                        Text="+"
                                        FontSize="28"
                                        BackgroundColor="#4B79E8"
                                        TextColor="White"
                                        CornerRadius="12"
                                        Clicked="OnPlusClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
